#!/bin/bash
# `omarchy plugin add` only clones files. It never runs package managers or
# sudo. This script installs liquidctl, the polkit helper, and the fan2go
# unit. Run it yourself, or press "Install dependencies" in the widget.
#
# The helper is privileged, so its bytes are checked against the SHA-256
# pinned below before anything is elevated. The elevated installer receives
# those bytes on stdin and does not open this checkout. fan2go itself is not
# downloaded: /usr/bin/fan2go must already be the packaged binary. The unit
# reads only /etc/fan2go/fan2go.yaml, and the helper is the only writer of
# that file. The daemon database is /var/lib/omaflow/fan2go.db.

set -euo pipefail

HERE="$(cd "$(dirname "$0")" && pwd)"
USER_NAME="${SUDO_USER:-$USER}"
USER_HOME="$(getent passwd "$USER_NAME" | cut -d: -f6)"
CONFIG_DIR="$USER_HOME/.config/omaflow"
HELPER_SRC="$HERE/scripts/omaflow_helper.py"
HELPER_DST="/usr/local/lib/omaflow/omaflow-helper"
HELPER_SHA256="4986dc0e2bd418bf6bd2f884edb5cd5ba297a1c98863b0f9d5cfcca73cc87ae9"
POLICY_DST="/usr/share/polkit-1/actions/org.omarchy.omaflow.helper.policy"
RULE_DST="/etc/polkit-1/rules.d/50-omaflow.rules"
UNIT_DST="/etc/systemd/system/fan2go.service"

FANS_ONLY=0
if [ "${1:-}" = "--fans-only" ]; then
  FANS_ONLY=1
fi

# Captured before the first sudo. Later steps pipe these variables and never
# pass a checkout path to a root process.
policy_xml="$(cat <<'EOF'
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>OmaFlow</vendor>
  <vendor_url>https://github.com/tempest-chaoscreator/OmaFlow</vendor_url>
  <action id="org.omarchy.omaflow.helper">
    <description>OmaFlow cooling helper</description>
    <message>OmaFlow wants to apply a checked fan curve</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/lib/omaflow/omaflow-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>
</policyconfig>
EOF
)"

rule_js="$(cat <<'EOF'
polkit.addRule(function(action, subject) {
    if (action.id == "org.omarchy.omaflow.helper" &&
        subject.isInGroup("wheel") &&
        subject.local &&
        subject.active) {
        return polkit.Result.YES;
    }
});
EOF
)"

unit_text="$(cat <<'EOF'
[Unit]
Description=fan2go (OmaFlow)
After=multi-user.target

[Service]
Type=simple
ExecStart=/usr/bin/fan2go -c /etc/fan2go/fan2go.yaml
Restart=on-failure
RestartSec=3
TimeoutStartSec=180
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/omaflow

[Install]
WantedBy=multi-user.target
EOF
)"

placeholder="$(cat <<'EOF'
dbPath: /var/lib/omaflow/fan2go.db
runFanInitializationInParallel: false
tempRollingWindowSize: 12
fanController:
  adjustmentTickRate: 1s
api:
  enabled: true
  host: 127.0.0.1
  port: 9001
sensors: []
curves: []
fans: []
EOF
)"

install_helper_py="$(cat <<'PY'
import base64, hashlib, os, stat, sys
expected, dest = sys.argv[1], sys.argv[2]
if dest != "/usr/local/lib/omaflow/omaflow-helper":
    sys.exit("unexpected helper destination")
data = base64.b64decode(sys.stdin.buffer.read(), validate=True)
digest = hashlib.sha256(data).hexdigest()
if digest != expected:
    sys.exit("elevated installer: helper digest mismatch")
if not data.startswith(b"#!/usr/bin/python3\n"):
    sys.exit("elevated installer: helper shebang mismatch")
parent = "/usr/local/lib/omaflow"
os.makedirs("/usr/local/lib", mode=0o755, exist_ok=True)
os.makedirs(parent, mode=0o755, exist_ok=True)
os.chmod(parent, 0o755)
fd = os.open("/", os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC)
try:
    for part in ("usr", "local", "lib", "omaflow"):
        nxt = os.open(part, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC, dir_fd=fd)
        os.close(fd)
        fd = nxt
    st = os.fstat(fd)
    if st.st_uid != 0 or stat.S_IMODE(st.st_mode) & 0o022:
        sys.exit("helper directory is not root-owned")
    tmp = ".omaflow-helper.tmp"
    try:
        os.unlink(tmp, dir_fd=fd)
    except FileNotFoundError:
        pass
    out = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC, 0o755, dir_fd=fd)
    try:
        os.write(out, data)
        os.fchmod(out, 0o755)
        os.fchown(out, 0, 0)
        os.fsync(out)
    finally:
        os.close(out)
    os.rename(tmp, "omaflow-helper", src_dir_fd=fd, dst_dir_fd=fd)
    os.fsync(fd)
finally:
    os.close(fd)
print(digest)
PY
)"

publish_py="$(cat <<'PY'
import os, stat, sys
allowed = {
    "/usr/share/polkit-1/actions/org.omarchy.omaflow.helper.policy": 0o644,
    "/etc/polkit-1/rules.d/50-omaflow.rules": 0o644,
    "/etc/systemd/system/fan2go.service": 0o644,
}
dest = sys.argv[1]
if dest not in allowed:
    sys.exit("refusing destination")
mode = allowed[dest]
data = sys.stdin.buffer.read()
if not data or len(data) > 65536:
    sys.exit("empty or oversized payload")
parent, name = dest.rsplit("/", 1)
os.makedirs(parent, mode=0o755, exist_ok=True)
fd = os.open("/", os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC)
try:
    for part in [p for p in parent.split("/") if p]:
        nxt = os.open(part, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC, dir_fd=fd)
        os.close(fd)
        fd = nxt
    st = os.fstat(fd)
    if st.st_uid != 0 or stat.S_IMODE(st.st_mode) & 0o022:
        sys.exit(f"{parent} is not a root-owned directory")
    tmp = "." + name + ".tmp"
    try:
        os.unlink(tmp, dir_fd=fd)
    except FileNotFoundError:
        pass
    out = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC, mode, dir_fd=fd)
    try:
        os.write(out, data)
        os.fchmod(out, mode)
        os.fchown(out, 0, 0)
        os.fsync(out)
    finally:
        os.close(out)
    os.rename(tmp, name, src_dir_fd=fd, dst_dir_fd=fd)
    os.fsync(fd)
finally:
    os.close(fd)
PY
)"

read_regular() {
  /usr/bin/python3 - "$1" "$2" <<'PY'
import os, stat, sys
path, limit = sys.argv[1], int(sys.argv[2])
fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC)
try:
    st = os.fstat(fd)
    if not stat.S_ISREG(st.st_mode) or st.st_size > limit:
        sys.exit(1)
    data = os.read(fd, limit + 1)
finally:
    os.close(fd)
if len(data) != st.st_size:
    sys.exit(1)
sys.stdout.buffer.write(data)
PY
}

echo "OmaFlow setup"
echo "-------------"
if [ "$FANS_ONLY" -eq 1 ]; then
  echo "Fans only: the helper. liquidctl is skipped."
fi
echo
echo "fan2go is not downloaded. Setup uses /usr/bin/fan2go only when that"
echo "file is already a root-owned package binary."
echo

if [ "$FANS_ONLY" -eq 0 ]; then
  echo "Installing liquidctl from the Omarchy package set…"
  omarchy-pkg-add liquidctl
else
  echo "Skipping liquidctl (motherboard-header cooler, no USB link)."
fi

echo
if [ -x /usr/bin/fan2go ]; then
  echo "fan2go is present at /usr/bin/fan2go."
else
  echo "fan2go is not installed at /usr/bin/fan2go."
  echo "Install that package yourself, then run setup again to enable the service."
  echo "Until then the helper can still set chassis PWM directly."
fi

echo
echo "Checking the helper against the reviewed digest…"
helper_b64="$(
  /usr/bin/python3 - "$HELPER_SRC" "$HELPER_SHA256" <<'PY'
import base64, hashlib, os, stat, sys
src, expected = sys.argv[1], sys.argv[2]
fd = os.open(src, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC)
try:
    st = os.fstat(fd)
    if not stat.S_ISREG(st.st_mode) or st.st_size <= 0 or st.st_size > 256 * 1024:
        sys.exit("helper source is not a regular file")
    data = os.read(fd, st.st_size + 1)
finally:
    os.close(fd)
if len(data) != st.st_size:
    sys.exit("helper source changed size while it was being read")
digest = hashlib.sha256(data).hexdigest()
if digest != expected:
    sys.exit(
        "helper digest mismatch\n"
        f"  got      {digest}\n"
        f"  expected {expected}\n"
        "The pinned digest and scripts/omaflow_helper.py must be updated together."
    )
if not data.startswith(b"#!/usr/bin/python3\n"):
    sys.exit("helper shebang must be /usr/bin/python3")
sys.stdout.write(base64.b64encode(data).decode("ascii"))
PY
)"

user_yaml=""
if [ -e "$CONFIG_DIR/fan2go.yaml" ]; then
  if user_yaml="$(read_regular "$CONFIG_DIR/fan2go.yaml" 65536)"; then
    :
  else
    echo "Ignoring $CONFIG_DIR/fan2go.yaml because it is not a regular file."
    user_yaml=""
  fi
fi

root_yaml=""
if [ -r /etc/fan2go/fan2go.yaml ]; then
  if root_yaml="$(read_regular /etc/fan2go/fan2go.yaml 65536)"; then
    :
  else
    root_yaml=""
  fi
fi

echo
echo "Installing the privileged helper…"
installed_digest="$(printf '%s' "$helper_b64" | sudo /usr/bin/python3 -c "$install_helper_py" "$HELPER_SHA256" "$HELPER_DST")"
if [ "$installed_digest" != "$HELPER_SHA256" ]; then
  echo "The installed helper digest does not match the reviewed pin." >&2
  exit 1
fi

printf '%s\n' "$policy_xml" | sudo /usr/bin/python3 -c "$publish_py" "$POLICY_DST"
printf '%s\n' "$rule_js" | sudo /usr/bin/python3 -c "$publish_py" "$RULE_DST"
printf '%s\n' "$unit_text" | sudo /usr/bin/python3 -c "$publish_py" "$UNIT_DST"

install -d -m 0755 "$CONFIG_DIR"
if [ "$(id -u)" -eq 0 ]; then
  chown -R "$USER_NAME:$USER_NAME" "$CONFIG_DIR" || true
fi

if [ "$FANS_ONLY" -eq 0 ] && command -v udevadm >/dev/null 2>&1; then
  sudo /usr/bin/udevadm control --reload-rules || true
  sudo /usr/bin/udevadm trigger || true
fi

echo "Publishing a root-owned fan2go config…"
# Stop the daemon before copying its database so the sqlite file is quiescent.
if [ -x /usr/bin/fan2go ]; then
  sudo /usr/bin/systemctl stop fan2go.service || true
fi
if ! sudo "$HELPER_DST" import-db; then
  echo "Database import failed. Starting fan2go again with the previous unit." >&2
  sudo /usr/bin/systemctl start fan2go.service || true
  exit 1
fi
published=0
if [ -n "$user_yaml" ]; then
  if sudo "$HELPER_DST" install-config "$user_yaml"; then
    published=1
  else
    echo "The saved curve file was rejected and was not given to the root service."
  fi
fi
if [ "$published" -eq 0 ] && [ -n "$root_yaml" ]; then
  if sudo "$HELPER_DST" install-config "$root_yaml"; then
    published=1
  else
    echo "The existing root config was rejected."
  fi
fi
if [ "$published" -eq 0 ]; then
  sudo "$HELPER_DST" install-config "$placeholder"
fi

sudo /usr/bin/systemctl daemon-reload
if sudo "$HELPER_DST" check-fan2go; then
  sudo /usr/bin/systemctl enable fan2go.service
  sudo /usr/bin/systemctl restart fan2go.service
  echo "fan2go is running from /etc/fan2go/fan2go.yaml."
else
  sudo /usr/bin/systemctl disable --now fan2go.service || true
  echo "The fan2go service was not enabled."
fi

echo
echo "OmaFlow setup is done."
echo "  liquidctl status     — AIO telemetry"
echo "  fan2go detect        — chassis fans, when /usr/bin/fan2go is installed"
echo
echo "The bar widget applies Silent on first use. Open it to edit curves."
